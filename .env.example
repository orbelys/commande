# Copier ce fichier en ".env.local" pour passer en mode réel.
# .env.local n'est jamais versionné (voir .gitignore).
# Sans ce fichier, l'application tourne en simulation avec des données fictives.

# Transport actif : "mock" (simulation locale) ou "firebase"
VITE_TRANSPORT=mock

# --- Firebase ---
# Console Firebase → Paramètres du projet → Vos applications → Web.
# Ces valeurs sont publiques par conception : la sécurité vient des règles
# Firestore (voir firestore.rules), pas du secret de ces clés.
# N'ajoutez JAMAIS ici un mot de passe ou une clé privée de compte de service.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Facultatif
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
